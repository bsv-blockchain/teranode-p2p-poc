# Sample configuration for teranode-p2p
p2p:
  port: 9901

  # Bootstrap peers for libp2p discovery (no DHT in this POC).
  # /dnsaddr/ entries resolve via DNS TXT to current bootstrap multiaddrs.
  # Managed by BSV Association — contact BSVA to be added.
  # Override with pipe-separated /dns4/ or /ip4/ multiaddrs.
  bootstrap_peers:
    - "/dnsaddr/mainnet.bootstrap.teranode.bsvb.tech"
    - "/dnsaddr/testnet.bootstrap.teranode.bsvb.tech"
    - "/dnsaddr/teratestnet.bootstrap.teranode.bsvb.tech"
    - "/dnsaddr/tstn.bootstrap.teranode.bsvb.tech"

  dht_mode: "off"           # off | client | server

  announce_addrs: []        # optional; empty = libp2p auto-detect
  peer_cache_file: ""       # optional; "" disables peer cache persistence

  # Connection manager (zero = library defaults)
  max_connections: 0
  min_connections: 0

database:
  path: "./teranode-p2p.db"

# New configuration: specify networks to subscribe to
# The system will automatically generate all topic combinations for these networks
networks:
  - "mainnet"
  - "testnet"
  - "regtest"
  - "stn"
  - "teratestnet"
  - "tstn"

# Legacy configuration (deprecated, use 'networks' instead)
# topics:
#   - "bitcoin/mainnet-bestblock"
#   - "bitcoin/mainnet-block"
#   - "bitcoin/mainnet-subtree"
#   - "bitcoin/mainnet-miningon"
#   - "bitcoin/mainnet-handshake"
#   - "bitcoin/mainnet-rejected_tx"
#   ... (and so on for all networks)
